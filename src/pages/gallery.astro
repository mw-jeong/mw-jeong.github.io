---
import Base from '../layouts/Base.astro';
import { gallery, photoSrc } from '../data/cv';
import { formatDays } from '../lib/format';
---

<Base title="Gallery" description="Photos from conferences, talks, and other moments.">
  <div class="container">
    <h1 class="page-title">Gallery</h1>
    {gallery.length === 0 && <p class="empty">No photos yet.</p>}
    {
      gallery.map((ev) => (
        <section class="row event" id={ev.id} aria-labelledby={`${ev.id}-t`}>
          <div class="when">{formatDays(ev.start, ev.end)}</div>
          <div>
            <h2 class="title" id={`${ev.id}-t`}>{ev.title}</h2>
            <div class="place">{ev.place}</div>
            <p class="note">{ev.note}</p>
            <div class:list={['photos', `n${Math.min(ev.photos.length, 4)}`]}>
              {ev.photos.map((p, i) => (
                <figure>
                  <button type="button" class="open" data-full={photoSrc(ev.id, i + 1)} data-caption={p.caption ?? ev.title} aria-label={`Enlarge: ${p.alt}`}>
                    <img src={photoSrc(ev.id, i + 1, true)} alt={p.alt} loading="lazy" decoding="async" />
                  </button>
                  {p.caption && <figcaption>{p.caption}</figcaption>}
                </figure>
              ))}
            </div>
          </div>
        </section>
      ))
    }
  </div>

  <dialog class="viewer" id="viewer" aria-label="Photo">
    <img id="viewer-img" alt="" />
    <p id="viewer-cap"></p>
    <button type="button" class="close" aria-label="Close">Close</button>
  </dialog>
</Base>

<script>
  const dlg = document.getElementById('viewer') as HTMLDialogElement;
  const img = document.getElementById('viewer-img') as HTMLImageElement;
  const cap = document.getElementById('viewer-cap') as HTMLParagraphElement;
  document.querySelectorAll<HTMLButtonElement>('.open').forEach((b) => {
    b.addEventListener('click', () => {
      img.src = b.dataset.full ?? '';
      img.alt = b.querySelector('img')?.alt ?? '';
      cap.textContent = b.dataset.caption ?? '';
      dlg.showModal();
    });
  });
  // close on the button, on a click anywhere, or with Esc (built into <dialog>)
  dlg.addEventListener('click', () => dlg.close());
</script>

<style>
  .event {
    padding: 22px 0 26px;
    border-top: 1px solid var(--rule);
    scroll-margin-top: 76px;
  }
  .event:first-of-type {
    border-top: 0;
  }
  .title {
    font-size: 17px;
    font-weight: 500;
    margin: 0;
    line-height: 1.4;
  }
  .place {
    color: var(--ink-2);
    font-size: 14.5px;
    margin-top: 2px;
  }
  .note {
    margin: 10px 0 14px;
    max-width: 64ch;
  }
  .photos {
    display: grid;
    gap: 10px;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .photos.n1 {
    grid-template-columns: minmax(0, 1fr);
    max-width: 300px;
  }
  .photos.n2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    max-width: 520px;
  }
  figure {
    margin: 0;
  }
  .open {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: var(--rule);
    cursor: zoom-in;
    border-radius: 3px;
    overflow: hidden;
  }
  .open:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .open img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: opacity 0.2s;
  }
  .open:hover img {
    opacity: 0.88;
  }
  figcaption {
    margin-top: 5px;
    font-size: 13px;
    color: var(--ink-2);
  }
  .empty {
    color: var(--ink-2);
  }
  .viewer {
    border: 0;
    padding: 0;
    background: transparent;
    max-width: min(92vw, 1400px);
    max-height: 92vh;
    overflow: visible;
  }
  .viewer::backdrop {
    background: rgba(20, 24, 28, 0.86);
  }
  .viewer img {
    display: block;
    max-width: min(92vw, 1400px);
    max-height: 84vh;
    margin: 0 auto;
    border-radius: 2px;
  }
  .viewer p {
    margin: 10px 0 0;
    text-align: center;
    color: #e6e8ea;
    font-size: 14px;
  }
  .viewer .close {
    position: fixed;
    top: 16px;
    right: 20px;
    font: inherit;
    font-size: 14px;
    color: #fff;
    background: none;
    border: 0;
    cursor: pointer;
  }
  @media (max-width: 640px) {
    .photos,
    .photos.n2 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
