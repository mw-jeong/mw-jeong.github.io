---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Row from '../components/Row.astro';
import Pub from '../components/Pub.astro';
import NewsList from '../components/NewsList.astro';
import GalleryPreview from '../components/GalleryPreview.astro';
import {
  gallery,
  education,
  publications,
  experience,
  teaching,
  awardsGraduate,
  awardsUndergrad,
  scholarships,
  news,
} from '../data/cv';

const NEWS_ON_HOME = 4;
---

<Base>
  <Hero />
  <div class="container">
    <!-- News and Gallery side by side; each shows the latest few and links to its own page -->
    <div class="news-gallery">
      <Section id="news" title="News">
        <NewsList items={news.slice(0, NEWS_ON_HOME)} compact />
        {news.length > NEWS_ON_HOME && (
          <p class="more">
            <a href="/news">All news</a>
          </p>
        )}
      </Section>
      {
        gallery.length > 0 && (
          <Section id="gallery" title="Gallery">
            <GalleryPreview count={3} />
            <p class="more">
              <a href="/gallery">All photos</a>
            </p>
          </Section>
        )
      }
    </div>

    <Section id="education" title="Education">
      {education.map((e) => <Row entry={e} />)}
    </Section>

    <Section id="publications" title="Publications">
      {publications.map((p) => <Pub pub={p} />)}
    </Section>

    <Section id="experience" title="Experience">
      {experience.map((e) => <Row entry={e} />)}
    </Section>

    <Section id="teaching" title="Teaching">
      {teaching.map((e) => <Row entry={e} />)}
    </Section>

    {
      (awardsGraduate.length > 0 || awardsUndergrad.length > 0) && (
        <Section id="awards" title="Awards">
          {awardsGraduate.length > 0 && <h3 class="subhead">Graduate</h3>}
          {awardsGraduate.map((e) => <Row entry={e} />)}
          {awardsUndergrad.length > 0 && <h3 class="subhead">Undergraduate (selected)</h3>}
          {awardsUndergrad.map((e) => <Row entry={e} />)}
        </Section>
      )
    }

    {
      scholarships.length > 0 && (
        <Section id="scholarships" title="Scholarships">
          {scholarships.map((e) => <Row entry={e} />)}
        </Section>
      )
    }
  </div>
</Base>

<style>
  .news-gallery {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: 48px;
    align-items: start;
  }
  @media (max-width: 760px) {
    .news-gallery {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
  }
</style>
